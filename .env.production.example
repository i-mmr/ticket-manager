# 本番用 Docker Compose 変数。
# 実ファイルは VPS 上で .env.production として作成し、強いパスワードに変更する。

HTTP_PORT=80
HTTPS_PORT=443

# 本番で公開するドメイン。DNS の A レコードを VPS の IP に向ける。
DOMAIN=example.com

# Let's Encrypt の期限通知などを受け取るメールアドレス。
LETSENCRYPT_EMAIL=admin@example.com

MYSQL_DATABASE=ticket_manager
MYSQL_USER=ticket_manager
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
